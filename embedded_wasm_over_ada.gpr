project Embedded_Wasm_Over_Ada is

   for Languages use ("Ada");

   for Source_Dirs use ("src");
   for Main use ("second_main.adb");
   for Object_Dir use "out";

   for Runtime ("Ada") use "link_to_runtime";

   for Target use "arm-eabi";

   package Compiler is
      for Switches ("Ada") use ("-g", "-gnatwa", "-gnatQ", "-fstack-usage");
   end Compiler;

   package Linker is
      for Switches ("Ada") use (Project'Project_Dir & "link_to_interp");
   end Linker;

   package Builder is
      for Switches ("ada") use ("-g", "-O0");
   end Builder;

end Embedded_Wasm_Over_Ada;
